<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.zezeze.order.service.mapper.OrderMapper">

    <resultMap id="OrderVOResultMap" type="com.zezeze.order.api.vo.OrderVO">
        <id column="id" property="id"/>

        <result column="order_no" property="orderNo"/>
        <result column="user_id" property="userId"/>
        <result column="product_id" property="productId"/>
        <result column="product_name" property="productName"/>
        <result column="product_price" property="productPrice"/>
        <result column="quantity" property="quantity"/>
        <result column="total_amount" property="totalAmount"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <insert id="insertOrder"
            parameterType="com.zezeze.order.api.vo.OrderVO"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO t_order
        (
        order_no,
        user_id,
        product_id,
        product_name,
        product_price,
        quantity,
        total_amount,
        status,
        create_time
        )
        VALUES
        (
        #{orderNo},
        #{userId},
        #{productId},
        #{productName},
        #{productPrice},
        #{quantity},
        #{totalAmount},
        #{status},
        #{createTime}
        )
    </insert>

    <select id="selectOrderById"
            parameterType="java.lang.Long"
            resultMap="OrderVOResultMap">
        SELECT
        id,
        order_no,
        user_id,
        product_id,
        product_name,
        product_price,
        quantity,
        total_amount,
        status,
        create_time
        FROM t_order
        WHERE id = #{id}
    </select>

</mapper>